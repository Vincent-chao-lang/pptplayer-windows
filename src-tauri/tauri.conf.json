{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PPTPlayer",
  "version": "0.1.0",
  "identifier": "cn.pptplayer.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PPT 播放器",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#11151c",
        "dragDropEnabled": false
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
